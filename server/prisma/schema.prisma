// Prisma schema file for Differentiated Case Flow Management (DCFM) System
// Datasource connects to PostgreSQL (Neon in production) via DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum Role {
  CLERK
  JUDGE
  LAWYER
}

enum CaseStatus {
  PENDING
  LISTED
  DISPOSED
}

enum HearingOutcome {
  SCHEDULED
  HEARD
  ADJOURNED
  DISPOSED
}

enum PartyRole {
  PETITIONER
  RESPONDENT
  ADVOCATE
}

enum CaseType {
  BAIL
  CHEQUE_BOUNCE
  RENT_DISPUTE
  CIVIL_SUIT
  COMMERCIAL_DISPUTE
  PROPERTY_DISPUTE
}

// -------------------------------------------------------------
// MODELS
// -------------------------------------------------------------

// System user account with authentication details
model User {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  passwordHash  String
  role          Role
  createdAt     DateTime   @default(now())

  // Optional 1-to-1 relation with Judge profile (if role == JUDGE)
  judge         Judge?

  // Relations to audit logs and cases approved/overridden by this user
  auditLogs     AuditLog[]
  approvedCases Case[]     @relation("TrackApprovedBy")

  @@map("users")
}

// Judge profile containing courtroom assignments and daily listing capacity
model Judge {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courtroom     String
  dailyCapacity Int       @default(10)

  // Cases assigned to this judge and hearings presided over
  cases         Case[]
  hearings      Hearing[]

  @@map("judges")
}

// DCFM Track defining turnaround speed and adjournment gap rules
// Tracks: FAST (90 days / 7 gap), STANDARD (365 days / 21 gap), COMPLEX (730 days / 45 gap)
// Explicit relation names resolve the two foreign keys from Case (suggestedTrackId and trackId)
model Track {
  id             String   @id @default(uuid())
  name           String   @unique // FAST | STANDARD | COMPLEX
  targetDays     Int      // Maximum allowed days for case disposal
  gapDays        Int      // Minimum mandatory gap between consecutive hearings

  cases          Case[]   @relation("CurrentTrack")
  suggestedCases Case[]   @relation("SuggestedTrack")

  @@map("tracks")
}

// Court Case entity tracking lifecycle, complexity, priority, track approval, and assigned judge
model Case {
  id                  String     @id @default(uuid())
  caseNumber          String     @unique // e.g., DCM/2026/0001
  title               String
  caseType            CaseType
  filingDate          DateTime   @default(now())
  hasExpertEvidence   Boolean    @default(false)
  isUrgent            Boolean    @default(false)
  complexity          Int        // Computed complexity score

  // Track suggestion and human-in-the-loop approval
  suggestedTrackId    String
  suggestedTrack      Track      @relation("SuggestedTrack", fields: [suggestedTrackId], references: [id])
  trackId             String     // Current active track
  track               Track      @relation("CurrentTrack", fields: [trackId], references: [id])
  trackApproved       Boolean    @default(false)
  trackApprovedById   String?
  trackApprovedBy     User?      @relation("TrackApprovedBy", fields: [trackApprovedById], references: [id])
  trackOverrideReason String?

  status              CaseStatus @default(PENDING)
  priorityScore       Float      @default(0) // Higher score = listed earlier in cause list
  targetDisposalDate  DateTime   // filingDate + track.targetDays
  earliestNextDate    DateTime   // Earliest date this case is eligible to be listed
  adjournmentCount    Int        @default(0)
  disposedDate        DateTime?
  judgeId             String?
  judge               Judge?     @relation(fields: [judgeId], references: [id])

  parties             Party[]
  hearings            Hearing[]
  auditLogs           AuditLog[]

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Composite index for fast cause-list listing queries
  @@index([status, priorityScore])
  @@map("cases")
}

// Legal party or representative attached to a case
model Party {
  id     String    @id @default(uuid())
  caseId String
  case   Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  name   String
  role   PartyRole

  @@map("parties")
}

// Individual scheduled court session or hearing outcome record
model Hearing {
  id          String         @id @default(uuid())
  caseId      String
  case        Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  judgeId     String
  judge       Judge          @relation(fields: [judgeId], references: [id])
  hearingDate DateTime
  outcome     HearingOutcome @default(SCHEDULED)
  remarks     String?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("hearings")
}

// Audit trail tracking all key judicial administrative actions
model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // e.g. CASE_REGISTERED, TRACK_APPROVED, TRACK_OVERRIDDEN, HEARING_SCHEDULED, OUTCOME_RECORDED
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  details   String   // JSON string containing action metadata
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
