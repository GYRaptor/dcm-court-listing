# =============================================================================
# DCFM Case Listing System — Server Environment Configuration
# =============================================================================

# Server Port (Defaults to 5001 to prevent AirPlay conflicts on macOS)
PORT=5001

# Environment Mode (production / development / test)
NODE_ENV=production

# PostgreSQL Database Connection String (e.g. Neon Serverless Postgres)
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL="postgresql://neondb_owner:your_secure_password@ep-late-glitter-123456.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secret Key (Generate with: openssl rand -base64 32)
JWT_SECRET="your-256-bit-jwt-secret-key-replace-in-production"

# Frontend Client URL for CORS (e.g. Vercel deployment URL or localhost in dev)
CLIENT_URL="https://dcm-court-listing.vercel.app"
