# Server Configuration (Use 5001 on macOS to avoid AirPlay conflict on 5000)
PORT=5001
NODE_ENV=development

# Database Connection (Neon PostgreSQL)
# Example: postgresql://neondb_owner:password@ep-cold-dawn-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# JWT Authentication Secret
JWT_SECRET=

# Client URL (for CORS)
CLIENT_URL="http://localhost:5173"
